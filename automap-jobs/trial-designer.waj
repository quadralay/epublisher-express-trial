<?xml version="1.0" encoding="utf-8"?>
<Job name="trial-designer" version="1.0">
  <!-- The epublisher-docs design project used as a stationery (mode 3): design.wep supplies the
       "Designer Trial" target's settings, conditions and variables (including its AI Assistant ID);
       this job supplies only the guide. Publish with /publish-jobs, which resolves the
       DocsDesignerTrial destination from epublisher-docs\webworks\deploy-targets.xml. -->
  <Project path="C:\Projects\epublisher-docs\webworks\design\design.wep" useAsStationery="True" />
  <Files>
    <Group name="Designer Trial Guide">
      <Document path="..\latest\online-trial-guides\designer-trial\designer-trial-guide.md" />
    </Group>
  </Files>
  <Targets>
    <Target name="Designer Trial" format="WebWorks Reverb 2.0" formatType="Application" build="True" destination="DocsDesignerTrial" cleanOutput="True">
      <MergeSettings title="Designer Trial Guide">
        <Group name="Designer Trial Guide" />
      </MergeSettings>
    </Target>
  </Targets>
</Job>
