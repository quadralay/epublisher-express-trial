<?xml version="1.0" encoding="utf-8"?>
<Job name="trial-express" version="1.0">
  <!-- The epublisher-docs design project used as a stationery (mode 3): design.wep supplies the
       "Express Trial" target's settings, conditions and variables (including its AI Assistant ID);
       this job supplies only the guide. Publish with /publish-jobs, which resolves the
       DocsExpressTrial destination from epublisher-docs\webworks\deploy-targets.xml. -->
  <Project path="C:\Projects\epublisher-docs\webworks\design\design.wep" useAsStationery="True" />
  <Files>
    <Group name="Express Trial Guide">
      <Document path="..\latest\online-trial-guides\express-trial\express-trial-guide.md" />
    </Group>
  </Files>
  <Targets>
    <Target name="Express Trial" format="WebWorks Reverb 2.0" formatType="Application" build="True" destination="DocsExpressTrial" cleanOutput="True">
      <MergeSettings title="Express Trial Guide">
        <Group name="Express Trial Guide" />
      </MergeSettings>
    </Target>
  </Targets>
</Job>